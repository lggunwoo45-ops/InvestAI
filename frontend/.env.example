# Public, build-time frontend configuration. These values are visible in the browser bundle.
VITE_APP_ENV=local
VITE_NEWS_PROXY_URL=http://localhost:8787
VITE_DART_PROXY_URL=http://localhost:8788

# Server-only example for the optional local DART proxy.
# Never rename or expose this value as a VITE_ variable.
# DART_API_KEY=replace_on_the_server_only
