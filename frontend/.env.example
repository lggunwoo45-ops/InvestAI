# Public, build-time frontend configuration. These values are visible in the browser bundle.
VITE_APP_ENV=local
VITE_NEWS_PROXY_URL=http://localhost:8787

# Public read-only Upbit relay. Local Vite dev/preview provides /api/upbit automatically.
# GitHub Pages requires a separately deployed HTTPS relay; never put credentials here.
# VITE_UPBIT_RELAY_URL=https://your-market-server.example/api/upbit

# Optional domestic-stock relay ORIGIN (no path). Never expose KIS keys as VITE_ variables.
# Personal local testing works without this URL; see docs/DOMESTIC_STOCKS.md.
# VITE_STOCK_RELAY_URL=https://your-approved-stock-server.example

# Optional public proxy-base override. Leave unset during local Vite development
# so browser requests use the same-origin /api/dart route.
# VITE_DART_PROXY_URL=https://dart-proxy.example.test

# Server-only example for the optional local DART proxy.
# Never rename or expose this value as a VITE_ variable.
# DART_API_KEY=replace_on_the_server_only
